{
  "platform": "docker",
  "port": 3000,
  "build": {
    "dockerfile": "./iran/Dockerfile",
    "args": ["APP_DIR=iran", "NEXT_PUBLIC_EDITION=iran"],
    "location": "germany"
  },
  "disks": [
    {
      "name": "uploads",
      "mountTo": "/app/.storage"
    }
  ],
  "healthCheck": {
    "command": "CMD node -e \"fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
    "interval": 30,
    "timeout": 10,
    "retries": 3,
    "startPeriod": 60
  }
}
