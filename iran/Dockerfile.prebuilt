# Spotifood Iran — runtime image around an application built beforehand (GitHub Actions, see
# .github/workflows/deploy-iran.yml). Liara's builder then only installs production dependencies:
# a full `next build` there exceeds its 20-minute build limit.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_EDITION=iran \
    PORT=3000 \
    STORAGE_LOCAL_DIR=/app/.storage
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY --chown=node:node .next ./.next
COPY --chown=node:node public ./public
COPY --chown=node:node drizzle ./drizzle
COPY --chown=node:node messages ./messages
COPY --chown=node:node dist/seed.mjs ./dist/seed.mjs
COPY --chown=node:node next.config.ts ./
COPY --chown=node:node scripts/migrate.mjs ./scripts/migrate.mjs
COPY --chown=node:node scripts/demo-assets ./scripts/demo-assets
RUN mkdir -p /app/.storage && chown node:node /app/.storage
USER node
EXPOSE 3000
# 1. migrations  2. platform data (+ Brielle)  3. server
CMD ["sh", "-c", "node scripts/migrate.mjs && node dist/seed.mjs && exec node_modules/.bin/next start -H 0.0.0.0 -p ${PORT}"]
