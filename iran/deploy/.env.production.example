# Spotifood — Iran edition (Liara). Set these in Liara: app → Settings → Environment variables.
# Never commit real values.

NODE_ENV=production
NEXT_PUBLIC_EDITION=iran
APP_URL=https://your-domain.ir
# openssl rand -base64 48
APP_SECRET=

# Liara PostgreSQL (database → "connection info"). Use the private network address if the
# app and database are in the same Liara network.
DATABASE_URL=postgresql://root:PASSWORD@HOST:PORT/postgres
DATABASE_URL_DIRECT=postgresql://root:PASSWORD@HOST:PORT/postgres
DEFAULT_TIME_ZONE=Asia/Tehran

# Uploaded images. Option A (simple): the "uploads" disk declared in liara.json.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/.storage
# Option B (recommended when you scale): Liara Object Storage (S3-compatible).
# STORAGE_DRIVER=s3
# S3_ENDPOINT=   (endpoint shown in Liara panel → Object Storage → access keys)
# S3_REGION=default
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# Email: Liara mail server (SMTP)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Spotifood <no-reply@your-domain.ir>"
# Host, port and credentials: Liara panel → Mail server → SMTP access
SMTP_URL=smtps://USER:PASSWORD@SMTP_HOST:465

# Zarinpal (merchant id from your Zarinpal panel). Sandbox for tests: ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# First start: creates the platform super admin (only if it does not exist yet).
SEED_SUPERADMIN_EMAIL=admin@your-domain.ir
SEED_SUPERADMIN_PASSWORD=

# Server error alerts by SMS to the admin (needs SMS_PROVIDER=kavenegar). See docs/OPERATIONS.md
ALERT_PHONE=

# Spotifood's own Zarinpal merchant, for restaurants paying their Spotifood plan
# (Dashboard > Subscription). Empty = subscription payment off, no trial: nothing changes.
# Once set: 14-day trial for new restaurants, checkout, invoices. See docs/OPERATIONS.md
BILLING_ZARINPAL_MERCHANT_ID=

# Periodic jobs (satisfaction SMS), called by .github/workflows/uptime.yml. Long random value.
CRON_SECRET=

# Web Push (new orders for the team, order ready for guests). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@spotifood.ir
