# Spotifood — global edition. Set these in your hosting platform's environment settings.
# Never commit real values.

NODE_ENV=production
NEXT_PUBLIC_EDITION=global
APP_URL=https://your-domain.com
# openssl rand -base64 48
APP_SECRET=

# PostgreSQL 16+. DATABASE_URL_DIRECT must be a direct (non-pooled) connection: realtime uses LISTEN/NOTIFY.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/spotifood
DATABASE_URL_DIRECT=postgres://USER:PASSWORD@HOST:5432/spotifood
DEFAULT_TIME_ZONE=Europe/Paris

# Uploaded images: S3-compatible storage (AWS S3, Cloudflare R2, Scaleway, MinIO…)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Email: smtp or resend
EMAIL_PROVIDER=resend
EMAIL_FROM="Spotifood <no-reply@your-domain.com>"
RESEND_API_KEY=
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465

# Stripe (webhook endpoint: https://your-domain.com/api/v1/payments/webhooks/stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# First start: creates the platform super admin (only if it does not exist yet).
SEED_SUPERADMIN_EMAIL=admin@your-domain.com
SEED_SUPERADMIN_PASSWORD=
