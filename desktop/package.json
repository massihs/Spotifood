{
  "name": "spotifood-desktop",
  "productName": "Spotifood",
  "version": "1.0.3",
  "description": "Spotifood for Windows and macOS: the restaurant's till, with offline ordering and local printing.",
  "author": "Spotifood",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "ir.spotifood.desktop",
    "productName": "Spotifood",
    "artifactName": "Spotifood-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "offline/**",
      "setup/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Spotifood",
      "artifactName": "Spotifood-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Spotifood-mac.${ext}"
    },
    "publish": null
  }
}
